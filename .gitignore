# Fichier .gitignore pour le projet test-ir-shell

# Ignorer les fichiers et dossiers temporaires
*.tmp
*.tmp.*

# Ignorer les fichiers de build et de compilation
build/
dist/
target/

# Ignorer les fichiers de configuration de l'environnement de développement
.env
.vscode/
.idea/

# Ignorer les fichiers de logs
logs/
*.log

# Ignorer les fichiers de données et de cache
data/
cache/

# Ignorer les fichiers générés par les outils de développement
node_modules/
package-lock.json
yarn.lock

# Ignorer les fichiers spécifiques au système d'exploitation
.DS_Store
Thumbs.db

# Ignorer les fichiers de sauvegarde et de révision
*.bak
*.orig
*.rej
*.swp

# Ignorer les fichiers de déploiement et de publication
deploy/
publish/

# Ignorer les fichiers de test et de débogage
test/
debug/